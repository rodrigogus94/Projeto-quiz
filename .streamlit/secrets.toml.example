# Copie para .streamlit/secrets.toml e preencha com seus dados do Google Cloud.

[google_oauth]
client_id = "SEU_CLIENT_ID.apps.googleusercontent.com"
client_secret = "SEU_CLIENT_SECRET"
redirect_uri = "http://localhost:8501"

# E-mails autorizados a entrar como professor (primeiro acesso via Google)
[auth]
allowed_professor_emails = ["professor@escola.edu.br"]
allow_legacy_professor_login = false

# Login local (somente se allow_legacy_professor_login = true ou sem Google OAuth)
# professor_username = "professor"
# professor_password_hash = "hash_sha256_opcional"
