# Copie para .streamlit/secrets.toml (NÃO commitar — já está no .gitignore)
# Coloque o JSON do Google em .streamlit/google_client_secret.json (também ignorado pelo Git)

[google_oauth]
client_secret_file = ".streamlit/google_client_secret.json"
# redirect_uri = "http://localhost:8501"  # opcional; padrão vem do JSON

[auth]
allowed_professor_emails = ["professor@escola.edu.br"]
allow_legacy_professor_login = false
