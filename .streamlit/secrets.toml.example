# =============================================================================
# LOCAL (PC): copie para .streamlit/secrets.toml — NÃO commitar (está no .gitignore)
# =============================================================================
[google_oauth]
client_secret_file = ".streamlit/google_client_secret.json"
# redirect_uri opcional; padrão vem do JSON

[auth]
allowed_professor_emails = ["professor@escola.edu.br"]
allow_legacy_professor_login = false

# =============================================================================
# STREAMLIT CLOUD (deploy via GitHub):
# O JSON NÃO sobe no Git. Cole isto em: Manage app → Settings → Secrets
# =============================================================================
# [google_oauth]
# client_id = "SEU_CLIENT_ID.apps.googleusercontent.com"
# client_secret = "GOCSPX-SEU_SECRET"
# redirect_uri = "https://SEU-APP.streamlit.app"
#
# [auth]
# allowed_professor_emails = ["seuemail@escola.edu.br"]
# allow_legacy_professor_login = false
