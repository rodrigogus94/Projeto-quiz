# =============================================================================
# LOCAL (PC): copie este arquivo para .streamlit/secrets.toml
# NÃO commitar secrets.toml nem google_client_secret.json (estão no .gitignore)
# =============================================================================

[google_oauth]
# Opção A (recomendada): JSON do Google Cloud na pasta .streamlit/
client_secret_file = ".streamlit/google_client_secret.json"
redirect_uri = "http://localhost:8501"

# Opção B: colar client_id e client_secret direto aqui (sem JSON)
# client_id = "SEU_CLIENT_ID.apps.googleusercontent.com"
# client_secret = "GOCSPX-SEU_CLIENT_SECRET"
# redirect_uri = "http://localhost:8501"

[auth]
system_admin_email = "seu-email@gmail.com"
allow_legacy_professor_login = false

# Envio automático do arquivo de resultados dos alunos por e-mail.
# Para Gmail: crie uma "senha de app" em myaccount.google.com/apppasswords
# (requer verificação em 2 etapas ativada na conta).
[email]
username = "conta-que-envia@gmail.com"
password = "senha-de-app-de-16-letras"
professor_email = "professor@gmail.com"  # opcional; padrão: system_admin_email
# smtp_host = "smtp.gmail.com"           # opcional
# smtp_port = 587                        # opcional (use 465 para SSL)

# =============================================================================
# STREAMLIT CLOUD (deploy via GitHub):
# O JSON NÃO sobe no Git. Cole em: Manage app → Settings → Secrets
# =============================================================================
# [google_oauth]
# client_id = "SEU_CLIENT_ID.apps.googleusercontent.com"
# client_secret = "GOCSPX-SEU_CLIENT_SECRET"
# redirect_uri = "https://SEU-APP.streamlit.app"
#
# [auth]
# system_admin_email = "seu-email@gmail.com"
# allow_legacy_professor_login = false
